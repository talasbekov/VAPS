{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/dashboard/StatsCards/**",
              "components/general/Alert/**",
              "components/general/Avatar/**",
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Calendar/**",
              "components/general/Card/**",
              "components/general/Checkbox/**",
              "components/general/Dialog/**",
              "components/general/DropdownMenu/**",
              "components/general/Input/**",
              "components/general/Label/**",
              "components/general/Popover/**",
              "components/general/Progress/**",
              "components/general/Select/**",
              "components/general/Separator/**",
              "components/general/Table/**",
              "components/general/Tabs/**",
              "components/general/Textarea/**",
              "components/general/Toast/**",
              "components/general/Tooltip/**",
              "components/organization-structure/OrgNode/**",
              "components/theme/ThemeToggle/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
