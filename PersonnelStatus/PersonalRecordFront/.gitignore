# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
# каталог проверочной сборки (NEXT_DIST_DIR), чтобы не трогать .next стенда
/.next-build/
# каталог прод-стенда для гейта (scripts/prod-stand.sh, Plane №173)
/.next-prod/
# каталог мок-стенда (NEXT_PUBLIC_OPS_MOCK_DOMAINS на :3107)
/.next-mock/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Перенос Smart Josparlau (Этап M1): корневой .gitignore VAPS глушит `lib/`
# (python-паттерн) — фронтовые lib-каталоги здесь ЯВНО разглушены, иначе
# половина перенесённой логики молча не коммитится (поймано при первом же
# git add).
!lib/
!shared/lib/
!features/**/lib/

# Сырые находки смоук-обхода (e2e/smoke-buttons.spec.ts): снимок КОНКРЕТНОГО
# стенда с его id и данными — в истории ему делать нечего. Коммитится
# собранный отчёт (docs/), а не сырьё.
# Результаты смоук-обхода: и текущие, и сохранённые копии прошлых прогонов
# (`smoke-results-prev-<дата>`). Это артефакт запуска на 200 КБ JSON, а не
# исходники — в историю ему не место.
/smoke-results*/
/test-results/
/playwright-report/
.shot-tmp/
