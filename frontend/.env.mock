# Smart Josparlau frontend-only demo (мастер-промпт §8.1). Загружается через
# `npm run dev:mock` / `npm run build:mock` (vite --mode mock). Публичные
# значения — Vite инлайнит VITE_*-переменные в бандл, секретов быть не может.
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api
VITE_DEMO_SCENARIO=normal
VITE_DEMO_PERSONA=event_planner
VITE_DEMO_FAULT_PROFILE=none
VITE_ENABLE_DEMO_TOOLS=true
