# .env.mock — исключение: публичная demo-конфигурация Smart Josparlau
# frontend-only режима (мастер-промпт §8.1), без единого секрета. Без
# коммита `npm run dev:mock` не запустился бы «документированной командой
# без backend» (DoD) — нужен был бы ручной шаг вне репозитория.
!.env.mock

# временные фикстуры lint-canon.test.mjs (живут только внутри прогона; страховка от kill -9)
