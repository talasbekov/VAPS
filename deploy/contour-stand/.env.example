# Story 7.0 — минимальный стенд в контуре. Скопировать в .env, заполнить
# реальные значения. НЕ коммитить .env с секретами.

# --- Django ---
VAPS_SECRET_KEY=change-me
VAPS_DEBUG=0

# --- Postgres (см. Backend/VAPS/config/settings.py: VAPS_DB=postgres обязателен) ---
VAPS_DB=postgres
VAPS_DB_NAME=vaps
VAPS_DB_USER=vaps
VAPS_DB_PASSWORD=change-me
VAPS_DB_HOST=db
VAPS_DB_PORT=5432

# --- Redis (channel layer для WS, см. channel_layers_from_env) ---
VAPS_REDIS_URL=redis://redis:6379/0

# --- Экспорт-CLI (Task 3): каталог на носителе (volume/USB-точка монтирования) ---
VAPS_STAND_EXPORT_DIR=/export

# --- Образы стенда: поставляются через `docker load` из .tar-бандла (см.
# install-stand.sh), ключа build: в docker-compose.yml нет — контур офлайн. ---
VAPS_BACKEND_IMAGE=vaps-backend:contour-stand
