# Story 12.1 — прод nginx-конфиг. Файл — envsubst-ШАБЛОН (официальный
# механизм nginx:1.27-alpine: /etc/nginx/templates/*.template рендерится в
# /etc/nginx/conf.d/*.conf на старте контейнера, substitution ограничен
# ПЕРЕЧНЕМ РЕАЛЬНО ЗАДАННЫХ env-переменных контейнера — nginx-переменные
# рантайма ($http_upgrade, $uri, $remote_addr...) НЕ в этом списке и остаются
# литеральными, не затираются пустой строкой). Переменные шаблона —
# ${VAPS_PRIVATE_STORAGE_ROOT}, ${STATIC_ROOT}, ${VAPS_XACCEL_LOCATION},
# ${VAPS_ALLOWED_ORIGIN} — заданы в deploy/docker-compose.yml's `nginx.environment`.

# Origin-гард для WS (обязательство config/asgi.py, Решение №6, 11.1):
# AllowedHostsOriginValidator намеренно отсутствует на Django-стороне —
# Origin-фильтрация назначена nginx здесь, по номеру стори.
#
# Явный `"" 0;` — defense-in-depth (найдено ревью): compose требует
# VAPS_ALLOWED_ORIGIN через `:?` (docker-compose.yml), значит пустое значение
# сюда дойти не должно — но если это когда-то обойдут (ручной `docker run`
# в обход compose, будущая правка убрала `:?`), голая строка `"" 1;` без этой
# явной строки пропустила бы WS-запрос БЕЗ заголовка Origin вовсе (небраузерные
# клиенты его могут не слать) — ровно fail-open там, где нужен fail-closed.
map $http_origin $vaps_ws_origin_ok {
    default 0;
    "" 0;
    "${VAPS_ALLOWED_ORIGIN}" 1;
}

# Story 12.3 (review, Blind Hunter): config/settings.py's allowed_hosts_from_env
# now always accepts Host: 127.0.0.1/localhost — required so the app service's
# OWN healthcheck (hits http://127.0.0.1:8000/... directly, bypassing nginx
# entirely, container-internal) doesn't 400. But nginx forwards $host VERBATIM
# to app (`proxy_set_header Host $host;` below) — without this guard, an
# EXTERNAL client could send Host: 127.0.0.1 through nginx itself and have it
# reach Django looking identical to the trusted internal healthcheck, quietly
# reopening the exact Host-header-spoofing hole 12.1a's guard exists to close.
map $host $vaps_host_is_loopback_spoof {
    default 0;
    "127.0.0.1" 1;
    "localhost" 1;
}

server {
    # default_server ОБЯЗАТЕЛЕН (найдено живым прогоном): образ nginx:1.27-alpine
    # несёт свой /etc/nginx/conf.d/default.conf (root /usr/share/nginx/html),
    # который сортируется РАНЬШЕ vaps.conf алфавитно — без явного default_server
    # nginx отдаёт ВСЕ запросы на порт 80 default.conf'у, и весь этот server-блок
    # становится мёртвым кодом (симптом: 404 «/usr/share/nginx/html/...», а не
    # ошибка конфигурации — location-блоки корректны, но никогда не достигаются).
    listen 80 default_server;

    client_max_body_size 25m;  # синхронизировано вручную с VAPS_MAX_UPLOAD_MB
                                # (config/settings.py:274, дефолт 20MB) + запас
                                # на multipart-накладные расходы. Расхождение
                                # при смене одного из двух — предмет ручной
                                # сверки (envsubst не умеет единицы конвертировать).

    # X-Accel internal location (контракт apps/documents/services.py Д2/Д3,
    # story 6.1): xaccel_redirect_path() отдаёт "{location}/{uuid}",
    # storage_path() — "{root}/{uuid}" (плоско, без расширения) — alias мапит
    # 1:1, без лишнего сегмента пути.
    location ${VAPS_XACCEL_LOCATION}/ {
        internal;
        alias ${VAPS_PRIVATE_STORAGE_ROOT}/;
    }

    # Admin-статика (deferred-work.md's E12/12.1-долг: без collectstatic+alias
    # admin-CSS/JS не отдаются под DEBUG=False).
    location /static/ {
        alias ${STATIC_ROOT}/;
    }

    # WS — upgrade-заголовки + долгий read_timeout (буква эпика epics.md#L1280)
    # + Origin-гард выше.
    location /ws/ {
        if ($vaps_ws_origin_ok = 0) {
            return 403;
        }
        proxy_pass http://app:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # HTTP API + admin — обычный proxy. Loopback-Host-спуфинг-гард (Story
    # 12.3) — ПЕРВЫМ, до proxy_pass. NOT a bare $vaps_host_is_loopback_spoof
    # check: this container's OWN healthcheck (wget http://127.0.0.1/admin/
    # login/, below) legitimately sends Host: 127.0.0.1 too — it runs INSIDE
    # this nginx container, arriving with $remote_addr=127.0.0.1. An external
    # client spoofing the same Host header arrives via the published port
    # with its REAL address as $remote_addr (Docker's port-forwarding
    # preserves the true source IP) — that combination is what gets blocked,
    # not the Host value alone.
    location /api/ {
        set $vaps_host_spoof_guard "";
        if ($vaps_host_is_loopback_spoof) {
            set $vaps_host_spoof_guard "spoofed";
        }
        if ($remote_addr = 127.0.0.1) {
            set $vaps_host_spoof_guard "";
        }
        if ($vaps_host_spoof_guard = "spoofed") {
            return 403;
        }
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /admin/ {
        set $vaps_host_spoof_guard "";
        if ($vaps_host_is_loopback_spoof) {
            set $vaps_host_spoof_guard "spoofed";
        }
        if ($remote_addr = 127.0.0.1) {
            set $vaps_host_spoof_guard "";
        }
        if ($vaps_host_spoof_guard = "spoofed") {
            return 403;
        }
        proxy_pass http://app:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA — react-router's BrowserRouter (history-mode, frontend/src/app/App.tsx):
    # любой несовпавший путь падает на index.html, клиентский роутер решает
    # остальное. Контракт не был зафиксирован НИ ОДНОЙ предыдущей стори — впервые
    # здесь.
    root /frontend-dist;
    location / {
        try_files $uri /index.html;
    }
}
