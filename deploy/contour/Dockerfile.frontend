FROM smart-josparlau/contour-node-deps:1 AS builder
WORKDIR /app
COPY frontend/ ./
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=2048 \
    BACKEND_URL=http://backend:8000 NEXT_PUBLIC_API_URL= \
    NEXT_PUBLIC_MEDIA_URL= NEXT_PUBLIC_OPS_DATA_SOURCE=api \
    NEXT_PUBLIC_OPS_MOCK_DOMAINS= NEXT_PUBLIC_SENTRY_DSN= SENTRY_DSN=
RUN NEXTAUTH_SECRET=build-only-placeholder ./node_modules/.bin/next build

# Рантайм — только standalone-вывод Next: он сам несёт нужные модули
# (трассировка зависимостей). Копия полного prod node_modules (942 МБ) убрана.
FROM smart-josparlau/contour-node-base:1
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 \
    NODE_OPTIONS=--max-old-space-size=512 PORT=3000 HOSTNAME=0.0.0.0 TZ=UTC
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
RUN mkdir -p .next/cache && chown -R nextjs:nodejs .next/cache
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
