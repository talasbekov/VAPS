# Copy to .env and restrict: chmod 600 .env. Never commit .env.
# Replace this documentation-only IP with the actual LAN IP of the contour host.
BIND_IP=0.0.0.0
CONTOUR_PORT=3118
NEXTAUTH_URL=http://192.0.2.10:3118
ALLOWED_HOSTS=192.0.2.10,backend,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://192.0.2.10:3118
CSRF_TRUSTED_ORIGINS=http://192.0.2.10:3118
# Containers UTC; business dates use the agreed canonical timezone.
TIME_ZONE=Asia/Qyzylorda
# HTTP LAN acceptance defaults; set 1 only together with an HTTPS termination.
COOKIE_SECURE=0
POSTGRES_DB=smart_josparlau
POSTGRES_USER=smart_josparlau
# Generate three DIFFERENT fresh secrets on the destination, >=32 characters.
# For example: openssl rand -hex 32 (never reuse historical NEXTAUTH_SECRET).
POSTGRES_PASSWORD=
DJANGO_SECRET_KEY=
NEXTAUTH_SECRET=
# Optional, only for `bootstrap_contour --demo`; leave empty on a clean contour.
ACCESS_MATRIX_PASSWORD=
ROLE_ACCOUNTS_PASSWORD=
# Browser API and media always use relative same-origin URLs in this build.
# Server-only BACKEND_URL=http://backend:8000 is supplied by compose.
