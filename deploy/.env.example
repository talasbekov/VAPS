# Story 12.1 — пример окружения прод-compose (deploy/docker-compose.yml).
# Файл-ПРИМЕР, коммитится; реальный .env с секретами в git НЕ попадает и в
# бандл 12.2 НЕ едет — секреты доставляются отдельной процедурой (epic-AC 12.1).
# compose его сам НЕ читает — оператор передаёт явно, причём ДЛЯ ВСЕХ команд
# (интерполяция ${VAR:?} идёт и на down/logs/ps — без --env-file они падают
# на «required variable», остановить стек «без файла под рукой» нельзя):
#   docker compose --env-file /path/to/.env -f deploy/docker-compose.yml up -d
#   docker compose --env-file /path/to/.env -f deploy/docker-compose.yml down
#
# Пометки: [REQUIRED] — compose падает на up без значения (${VAR:?...});
# остальные имеют дефолт. Источник каждой переменной — файл:якорь в коде.
# ⚠️ Литеральный `$` в значениях (пароли!) удваивать: `pa$$word` → `pa$$$$word`
# — compose интерполирует env-файл до передачи в контейнер.

# --- Ядро Django (config/settings.py:8-9) -----------------------------------
# Прод обязан быть DEBUG=0: при 0 settings fail-closed требует JWT-конфиг.
VAPS_DEBUG=0
# [REQUIRED] криптослучайная строка; генерация: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
VAPS_SECRET_KEY=

# --- База данных (config/settings.py, ветка VAPS_DB=postgres) ----------------
# VAPS_DB/VAPS_DB_HOST/VAPS_DB_PORT зашиты в compose (сервис db) — здесь не нужны.
VAPS_DB_NAME=vaps
VAPS_DB_USER=vaps
# [REQUIRED] ⚠️ POSTGRES_PASSWORD применяется ТОЛЬКО при первом initdb тома
# db_data: смена значения здесь ПОСЛЕ первого up рассинхронизирует app и БД
# (auth failed) — ротация пароля = ALTER ROLE в БД + правка здесь, парой.
VAPS_DB_PASSWORD=

# --- Auth: JWT внешнего издателя (config/settings.py jwt_config_from_env) ----
# [REQUIRED] ПУБЛИЧНЫЙ ключ издателя (PEM, RS256 по умолчанию). VAPS паролей не хранит.
# ⚠️ PEM многострочен: значение писать В ДВОЙНЫХ КАВЫЧКАХ с \n вместо переводов
# строк — compose разворачивает escape-последовательности в quoted-значениях:
#   VAPS_JWT_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n"
# Наивно вставленный многострочный PEM ЛОМАЕТСЯ ТИХО: приложение стартует
# (settings проверяет только непустоту), а каждый логин бьёт 401.
VAPS_JWT_KEY=
VAPS_JWT_ALGORITHMS=RS256
# [REQUIRED] audience-confusion guard — прод без него не стартует.
VAPS_JWT_AUDIENCE=
# Опциональна (settings.py: `or None` — пустая = iss не проверяется).
VAPS_JWT_ISSUER=
VAPS_JWT_LEEWAY=0

# --- Redis / WS-брокер (config/settings.py channel_layers_from_env) ----------
# VAPS_REDIS_URL зашит в compose (redis://redis:6379/0 — имя сервиса сети
# compose, наружу порт не публикуется) — здесь не нужен.

# --- Файлы и статика (config/settings.py: VAPS_MAX_UPLOAD_MB, VAPS_XACCEL_*, STATIC_ROOT)
# VAPS_XACCEL_ENABLED=1, VAPS_XACCEL_LOCATION=/protected, VAPS_PRIVATE_STORAGE_ROOT
# и VAPS_STATIC_ROOT зашиты в compose (пути = alias'ы nginx) — здесь не нужны.
VAPS_MAX_UPLOAD_MB=20
# Пара к лимиту выше, уходит в nginx (envsubst в vaps.conf.template на старте
# контейнера — пересборка образа НЕ нужна). Держать СТРОГО БОЛЬШЕ
# VAPS_MAX_UPLOAD_MB: multipart-обвязка, иначе валидный upload умирает в nginx
# HTML-413 вместо §36-конверта Django. Правятся ТОЛЬКО парой.
VAPS_NGINX_MAX_BODY=25m
# Whitelist content-type вложений: дефолт живёт в коде (settings.py), compose
# переменную НЕ пробрасывает. Для переопределения добавить проброс в
# deploy/docker-compose.yml (сервис app) — НЕ через "${VAR:-}": пустая строка
# обнулила бы whitelist и все upload'ы падали бы валидацией.

# --- WebSocket (config/settings.py: VAPS_WS_ENABLED; стори 11.5) -------------
# Kill-switch: 0 гасит WS-канал (уведомления продолжают жить в БД/REST).
# Выключение = смена env + перезапуск контейнера app, БЕЗ переноса носителя.
VAPS_WS_ENABLED=1

# --- Топология (deploy/docker-compose.yml) -----------------------------------
# Публикуемый LAN-порт nginx; 8080 может быть закрыт периметром (спайк 1.9).
VAPS_HTTP_PORT=8080
# Тег образов vaps-app/vaps-nginx (12.2 будет ставить сюда версию релиза;
# дефолт dev — ТОЛЬКО для dev-прогонов, в контуре тег задаётся явно).
VAPS_IMAGE_TAG=dev
