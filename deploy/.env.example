# Story 12.1 — шаблон env-переменных прод-топологии. Значения ниже —
# ПЛЕЙСХОЛДЕРЫ, не реальные секреты. Реальные значения (VAPS_SECRET_KEY,
# VAPS_DB_PASSWORD, VAPS_JWT_KEY) копируются на целевую машину ОТДЕЛЬНЫМ
# каналом — не через .tar-бандл (12.2), не через git, не через этот файл.
# `.env` (без `.example`) уже покрыт корневым .gitignore (`.env`/`.env.*`) —
# реальный файл с секретами никогда не попадёт в репозиторий по построению.
# Детальный процедурный чек-лист переноса — CHECKLIST.md (Story 12.5).

# --- Секреты (ОБЯЗАТЕЛЬНО заменить перед запуском) ---
VAPS_SECRET_KEY=CHANGE_ME
VAPS_DB_PASSWORD=CHANGE_ME
# Публичный ключ издателя внешнего Auth (RS256) — обязателен в проде
# (DEBUG=0), иначе старт падает fail-closed (config/settings.py's
# jwt_config_from_env). Многострочный PEM в ОДНОЙ .env-строке: заменить
# реальные переводы строк на буквальные "\n" (Django просто читает
# os.environ.get() как есть — PyJWT сам не разбирает escape-последовательности,
# поэтому если оператор передаёт значение так — код на PEM-стороне должен
# делать key.replace("\\n", "\n") при загрузке; ЭТО ОТКРЫТЫЙ ВОПРОС, не решённый
# этой стори — конкретный механизм доставки (одна строка с \n, docker secrets,
# смонтированный файл) явно НЕ выбран здесь и остаётся за Story 12.5's
# CHECKLIST.md, которая описывает физический перенос секретов на машину).
VAPS_JWT_KEY=CHANGE_ME
VAPS_JWT_AUDIENCE=CHANGE_ME

# --- База ---
VAPS_DB=postgres
VAPS_DB_NAME=vaps
VAPS_DB_USER=vaps

# --- Не-секретные прод-настройки (безопасные дефолты для первого деплоя) ---
VAPS_DEBUG=0
VAPS_REDIS_URL=redis://redis:6379/0
VAPS_JWT_ALGORITHMS=RS256
VAPS_JWT_LEEWAY=0
VAPS_JWT_ISSUER=
VAPS_MAX_UPLOAD_MB=20
VAPS_PRIVATE_STORAGE_ROOT=/protected-storage
VAPS_XACCEL_ENABLED=1
VAPS_XACCEL_LOCATION=/protected
VAPS_WS_ENABLED=1
VAPS_STATIC_ROOT=/app/staticfiles

# --- nginx-only (Django эту переменную не читает) ---
# Единственное разрешённое значение заголовка Origin для WS-апгрейда
# (config/asgi.py's Решение №6 — Origin-фильтрация назначена nginx).
# Пример: http://vaps.contour.local
VAPS_ALLOWED_ORIGIN=CHANGE_ME
