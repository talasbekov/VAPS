COOKIE_SECURE=0
ENABLE_BACKGROUND_TASKS=1
OPS_ASSISTANT_PROVIDER=disabled
OPS_ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
OPS_ASSISTANT_MODEL=qwen2.5:7b
POSTGRES_DB=smart_josparlau
