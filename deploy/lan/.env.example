# Use `python3 configure.py --ip <LAN-server-IPv4>` to generate a private .env.
# This template is deliberately not runnable: do not retain an address from a past site.
STACK_NAME=smart-josparlau-lan
BIND_IP=
FRONTEND_PORT=3300
BACKEND_PORT=8300
POSTGRES_PORT=5300
NEXTAUTH_URL=
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
