diff --git a/deploy/contour/nginx-error-filter.awk b/deploy/contour/nginx-error-filter.awk
new file mode 100644
index 00000000..50de90fa
--- /dev/null
+++ b/deploy/contour/nginx-error-filter.awk
@@ -0,0 +1,7 @@
+# nginx error messages can repeat the URI in request, upstream and referrer.
+# Strip query segments everywhere while preserving the diagnostic and paths.
+{
+    gsub(/\?[^[:space:]"]*/, "?[redacted]")
+    print
+    fflush()
+}
