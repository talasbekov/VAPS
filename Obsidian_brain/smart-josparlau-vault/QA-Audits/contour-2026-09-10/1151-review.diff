diff --git a/deploy/contour/nginx.conf b/deploy/contour/nginx.conf
index 297c7013..a4a63462 100644
--- a/deploy/contour/nginx.conf
+++ b/deploy/contour/nginx.conf
@@ -3,11 +3,18 @@ map $http_upgrade $connection_upgrade {
     '' close;
 }
 
+# WebSocket authentication can use a query JWT. Keep the URI path, never the
+# full request/request_uri, args or Referer (which can also contain a query).
+log_format contour_path '$remote_addr - $remote_user [$time_local] '
+                        '"$request_method $uri $server_protocol" '
+                        '$status $body_bytes_sent "$http_user_agent"';
+
 server {
     listen 80;
     server_name _;
     # Preserve the browser's external LAN port when nginx returns /admin/ etc.
     absolute_redirect off;
+    access_log /var/log/nginx/access.log contour_path;
     client_max_body_size 30m;
     proxy_http_version 1.1;
     proxy_set_header Host $http_host;
