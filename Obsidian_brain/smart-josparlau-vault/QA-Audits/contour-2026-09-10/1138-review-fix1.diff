diff --git a/deploy/contour/nginx.conf b/deploy/contour/nginx.conf
index 1605d4a1..297c7013 100644
--- a/deploy/contour/nginx.conf
+++ b/deploy/contour/nginx.conf
@@ -1,18 +1,20 @@
 map $http_upgrade $connection_upgrade {
     default upgrade;
     '' close;
 }
 
 server {
     listen 80;
     server_name _;
+    # Preserve the browser's external LAN port when nginx returns /admin/ etc.
+    absolute_redirect off;
     client_max_body_size 30m;
     proxy_http_version 1.1;
     proxy_set_header Host $http_host;
     proxy_set_header X-Real-IP $remote_addr;
     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
     proxy_set_header X-Forwarded-Proto $scheme;
     proxy_read_timeout 120s;
     add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" always;
 
     location /staticfiles/ { alias /data/static/; }
