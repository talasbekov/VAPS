{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next-load-a/types/**/*.ts",
    ".next-load-b/types/**/*.ts",
    ".next-load-base/types/**/*.ts",
    ".next-load-c/types/**/*.ts",
    ".next-measure-turbo/types/**/*.ts",
    ".next-measure-webpack/types/**/*.ts",
    ".next-mock/types/**/*.ts",
    ".next-mut/types/**/*.ts",
    ".next-prod/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
