# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
# каталог проверочной сборки (NEXT_DIST_DIR), чтобы не трогать .next стенда
/.next-build/
# каталог прод-стенда для гейта (scripts/prod-stand.sh, Plane №173)
/.next-prod/
# каталог мок-стенда (NEXT_PUBLIC_OPS_MOCK_DOMAINS на :3107)
/.next-mock/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Перенос Smart Josparlau (Этап M1): корневой .gitignore VAPS глушит `lib/`
# (python-паттерн) — фронтовые lib-каталоги здесь ЯВНО разглушены, иначе
# половина перенесённой логики молча не коммитится (поймано при первом же
# git add).
!lib/
!shared/lib/
!features/**/lib/

# Сырые находки смоук-обхода (e2e/smoke-buttons.spec.ts): снимок КОНКРЕТНОГО
# стенда с его id и данными — в истории ему делать нечего. Коммитится
# собранный отчёт (docs/), а не сырьё.
# Результаты смоук-обхода: и текущие, и сохранённые копии прошлых прогонов
# (`smoke-results-prev-<дата>`). Это артефакт запуска на 200 КБ JSON, а не
# исходники — в историю ему не место.
/smoke-results*/
/test-results/
/playwright-report/
.shot-tmp/

# Снимки и файлы ручного тестирования (Plane №377): 9 МБ картинок и
# документов на один заход. В репозиторий они не едут — отчёт живёт в vault и
# ссылается на них по пути, а сами артефакты пересобираются прогоном.
/test-report-*/

# Снимки экрана В КОРНЕ фронта (Plane №761/№747). Их кладут пробы и разборы
# задач, и корень — не место для них: снимок КОНКРЕТНОГО стенда с его id и
# данными в истории репозитория бесполезен и тянется при каждом клоне (два
# файла №259 стоили 440 КБ и не читались никем).
#
# Правило узкое — только корень: `public/*.png` это поставка, `docs/` может
# нести артефакт разбора осознанно. Пробы пишут снимки в `smoke-results/`
# либо в `SHOTS`, и это стережёт `scripts/check-shot-paths`.
/*.png
