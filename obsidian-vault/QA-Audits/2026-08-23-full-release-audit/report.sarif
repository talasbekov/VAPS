          "level": "note",
          "message": {
            "text": "[RES-000026] User-submitted free text (comment body, feedback description/steps/contact) renders in plain `<p>` tags with zero break-words/overflow-wrap handling anywhere in the security-ops feature/app tree"
          },
          "locations": [
